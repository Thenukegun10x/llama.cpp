<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tool_settings"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/toggle_all_tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/all_tools"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="12dp">

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/toggle_sandbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tool_sandbox_files"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/toggle_web"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tool_web_search"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

    </LinearLayout>

</LinearLayout>
